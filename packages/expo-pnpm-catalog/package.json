{
  "name": "expo-pnpm-catalog",
  "version": "0.1.2",
  "description": "Checks and syncs Expo SDK versions in pnpm catalogs, like expo-doctor and expo install --fix for a whole pnpm workspace.",
  "keywords": [
    "expo",
    "react-native",
    "pnpm",
    "monorepo",
    "expo-doctor",
    "pnpm-workspace"
  ],
  "homepage": "https://github.com/arnaud-zg/packages/tree/main/packages/expo-pnpm-catalog#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/packages.git",
    "directory": "packages/expo-pnpm-catalog"
  },
  "license": "MIT",
  "author": "Arnaud Zheng <arnaud.zg@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "expo-pnpm-catalog": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache dist node_modules",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-location .cache/.prettiercache",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "prepublishOnly": "pnpm build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "js-yaml": "^5.5.0",
    "ora": "^10.0.0"
  },
  "devDependencies": {
    "@arnaud-zg/configs": "catalog:",
    "@types/node": "catalog:node",
    "builder-pattern": "^2.2.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
