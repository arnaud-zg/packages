{
  "name": "agent-context-budget",
  "version": "0.1.0",
  "description": "Token-budget analysis for AI agent context files like CLAUDE.md and AGENTS.md.",
  "keywords": [
    "claude-code",
    "claude-md",
    "agents-md",
    "token-budget",
    "context-window",
    "llm",
    "linter",
    "cli"
  ],
  "homepage": "https://github.com/arnaud-zg/packages/tree/main/packages/agent-context-budget#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/packages.git",
    "directory": "packages/agent-context-budget"
  },
  "license": "MIT",
  "author": "Arnaud Zheng <arnaud.zg@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "context-budget": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache dist node_modules",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-location .cache/.prettiercache",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "prepublishOnly": "pnpm build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@arnaud-zg/configs": "catalog:",
    "@types/node": "catalog:node",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
