{
  "name": "vite-workspace-resolver",
  "version": "0.1.0",
  "description": "Fix Vitest \"Failed to resolve import\" in a monorepo: a Vite plugin that resolves workspace exports-map subpaths and deep src/ imports, no aliases.",
  "keywords": [
    "vite",
    "vitest",
    "vite-plugin",
    "monorepo",
    "workspace",
    "pnpm-workspace",
    "resolver",
    "exports-map",
    "subpath-exports",
    "failed-to-resolve-import",
    "alias",
    "typescript"
  ],
  "homepage": "https://github.com/arnaud-zg/packages/tree/main/packages/vite-workspace-resolver#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/packages.git",
    "directory": "packages/vite-workspace-resolver"
  },
  "license": "MIT",
  "author": "Arnaud Zheng <arnaud.zg@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist node_modules",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-location .cache/.prettiercache",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "dependencies": {
    "resolve.exports": "^2.0.3"
  },
  "devDependencies": {
    "@arnaud-zg/configs": "catalog:",
    "@types/node": "catalog:node",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
